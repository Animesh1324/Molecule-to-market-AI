# development | production
APP_ENV=development

# Port the API listens on when started via run.py
PORT=8000

# Comma-separated list of allowed frontend origins. Must be set explicitly in
# production — the localhost fallback will block your deployed frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Leave blank to use the local SQLite file at backend/app/data/.
# Set to a PostgreSQL URL for any deployment with an ephemeral filesystem,
# otherwise all projects and brand plans are lost on restart.
# Example: postgresql://user:password@host:5432/brandplan
DATABASE_URL=

# Optional. Enables Claude drafting of the brand plan's strategy narrative.
# Without it the app falls back to the deterministic template — every other
# module keeps working. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model and reasoning effort for drafting (defaults shown).
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# Set to "off" to disable drafting even when a key is present.
AI_DRAFTING=on

# REQUIRED before exposing this app on any network. Every /api route returns
# 401 without it, and the backend refuses to start in production if it is unset.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACCESS_TOKEN=

# Optional. Enables the Drugs.com adapter, which targets the LICENSED
# Drugs.com/DrugBank data feed. The website itself is never scraped: it blocks
# programmatic access (HTTP 403) and its terms prohibit automated extraction.
# Without this key the adapter stays disabled and the app runs on openFDA.
DRUGS_COM_API_KEY=
# DRUGS_COM_API_BASE=https://api.drugs.com/v1
